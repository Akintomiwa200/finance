generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  FINANCE_MANAGER
  ACCOUNTANT_PAYABLE
  ACCOUNTANT_RECEIVABLE
  PAYROLL_OFFICER
  BUDGET_ANALYST
  DEPARTMENT_HEAD
  EMPLOYEE
  AUDITOR
  TAX_SPECIALIST
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  INTERNATIONAL_TRANSFER
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
}

enum PayrollStatus {
  DRAFT
  COMPUTED
  APPROVED
  PAID
  CANCELLED
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REIMBURSED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum BudgetStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountCategory {
  CURRENT
  FIXED
  INTANGIBLE
  LONG_TERM
  OPERATING
  NON_OPERATING
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum JournalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  REJECTED
}

enum JournalType {
  GENERAL
  ADJUSTING
  CLOSING
  REVERSING
  PAYROLL
  SALES
  PURCHASE
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum VendorType {
  SUPPLIER
  CONTRACTOR
  CONSULTANT
  SERVICE_PROVIDER
  INDIVIDUAL
}

enum PaymentTerms {
  NET_15
  NET_30
  NET_45
  NET_60
  NET_90
  DUE_ON_RECEIPT
  COD
}

enum BillStatus {
  DRAFT
  PENDING
  APPROVED
  PAID
  OVERDUE
  CANCELLED
}

enum BillType {
  PURCHASE
  SERVICE
  UTILITY
  RENT
  OTHER
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
  REJECTED
}

enum POPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
  COURIER
}

enum BillPaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum BillPaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  CREDIT_CARD
  ONLINE
}

model Organization {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  email      String?
  phone      String?
  address    String?
  logo       String?
  isPlatform Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  departments       Department[]
  employees         Employee[]
  budgets           Budget[]
  payrollRuns       PayrollRun[]
  customerInvoices  CustomerInvoice[]
  vendorInvoices    VendorInvoice[]
  taxConfigurations TaxConfiguration[]
  auditLogs         AuditLog[]
  transactions      Transaction[]
  accounts          Account[]
  journalEntries    JournalEntry[]
  vendors           Vendor[]
  vendorBills       VendorBill[]
  purchaseOrders    PurchaseOrder[]
  billPayments      BillPayment[]
}

model Department {
  id             String       @id @default(cuid())
  name           String
  code           String       @unique
  description    String?
  costCenter     String?
  budgetAmount   Decimal?     @default(0) @db.Decimal(15, 2)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  head      String?
  employees Employee[]
  budgets   Budget[]
}

model Employee {
  id           String   @id @default(cuid())
  employeeCode String   @unique
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  position     String?
  baseSalary   Decimal? @default(0) @db.Decimal(15, 2)
  passwordHash String?
  bankName     String?
  bankAccount  String?
  bankCode     String?
  taxId        String?
  hireDate     DateTime?
  isActive     Boolean  @default(true)
  role         Role     @default(EMPLOYEE)

  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollItems      PayrollItem[]
  expenseReports    ExpenseReport[]
  timesheets        Timesheet[]
  loans             EmployeeLoan[]
  approvals         ApprovalRequest[]
  approvalsApproved ApprovalRequest[] @relation("ApproverRelation")
}

model Timesheet {
  id          String         @id @default(cuid())
  date        DateTime
  hoursWorked Decimal?       @db.Decimal(5, 2)
  overtime    Decimal?       @default(0) @db.Decimal(5, 2)
  status      ApprovalStatus @default(PENDING)
  notes       String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayrollRun {
  id          String        @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  totalAmount Decimal?      @default(0) @db.Decimal(15, 2)
  status      PayrollStatus @default(DRAFT)
  processedAt DateTime?
  notes       String?
  processedBy String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PayrollItem[]
}

model PayrollItem {
  id            String  @id @default(cuid())
  grossPay      Decimal @db.Decimal(15, 2)
  deductions    Decimal @default(0) @db.Decimal(15, 2)
  taxAmount     Decimal @default(0) @db.Decimal(15, 2)
  netPay        Decimal @db.Decimal(15, 2)
  allowances    Decimal @default(0) @db.Decimal(15, 2)
  bonus         Decimal @default(0) @db.Decimal(15, 2)
  loanDeduction Decimal @default(0) @db.Decimal(15, 2)
  overtimePay   Decimal @default(0) @db.Decimal(15, 2)

  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExpenseReport {
  id          String        @id @default(cuid())
  title       String
  description String?
  totalAmount Decimal       @default(0) @db.Decimal(15, 2)
  status      ExpenseStatus @default(DRAFT)
  submittedAt DateTime?
  approvedAt  DateTime?
  receiptUrl  String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ExpenseItem[]
}

model ExpenseItem {
  id          String   @id @default(cuid())
  category    String
  description String
  amount      Decimal  @db.Decimal(15, 2)
  receiptUrl  String?
  expenseDate DateTime

  expenseReportId String
  expenseReport   ExpenseReport @relation(fields: [expenseReportId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerInvoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  customerName    String
  customerEmail   String?
  customerAddress String?
  totalAmount     Decimal       @db.Decimal(15, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(15, 2)
  dueDate         DateTime
  status          InvoiceStatus @default(DRAFT)
  notes           String?
  pdfUrl          String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CustomerInvoiceItem[]
}

model CustomerInvoiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(15, 2)
  total       Decimal @db.Decimal(15, 2)

  invoiceId String
  invoice   CustomerInvoice @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VendorInvoice {
  id            String        @id @default(cuid())
  vendorName    String
  invoiceNumber String
  totalAmount   Decimal       @db.Decimal(15, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(15, 2)
  dueDate       DateTime
  status        InvoiceStatus @default(DRAFT)
  notes         String?
  documentUrl   String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Budget {
  id          String       @id @default(cuid())
  fiscalYear  Int
  totalAmount Decimal      @db.Decimal(15, 2)
  spentAmount Decimal      @default(0) @db.Decimal(15, 2)
  status      BudgetStatus @default(ACTIVE)

  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems BudgetLineItem[]
}

model BudgetLineItem {
  id          String  @id @default(cuid())
  category    String
  description String?
  allocated   Decimal @db.Decimal(15, 2)
  spent       Decimal @default(0) @db.Decimal(15, 2)

  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeLoan {
  id                String         @id @default(cuid())
  amount            Decimal        @db.Decimal(15, 2)
  monthlyDeduction  Decimal        @db.Decimal(15, 2)
  remainingBalance  Decimal        @db.Decimal(15, 2)
  totalInstallments Int
  paidInstallments  Int            @default(0)
  status            ApprovalStatus @default(PENDING)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApprovalRequest {
  id          String         @id @default(cuid())
  title       String
  description String?
  type        String
  status      ApprovalStatus @default(PENDING)
  priority    String         @default("NORMAL")
  dueDate     DateTime?

  requesterId String
  requester   Employee @relation(fields: [requesterId], references: [id])

  approverId String?
  approver   Employee? @relation("ApproverRelation", fields: [approverId], references: [id])

  approvedAt DateTime?
  comments   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps ApprovalStep[]
}

model ApprovalStep {
  id        String         @id @default(cuid())
  stepOrder Int
  role      Role
  status    ApprovalStatus @default(PENDING)
  comment   String?

  requestId String
  request   ApprovalRequest @relation(fields: [requestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaxConfiguration {
  id        String   @id @default(cuid())
  name      String
  rate      Decimal  @db.Decimal(5, 2)
  threshold Decimal? @db.Decimal(15, 2)
  isActive  Boolean  @default(true)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String  @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?

  userId   String?
  userName String?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
}

model Notification {
  id       String  @id @default(cuid())
  title    String
  message  String
  body     String?
  type     String  @default("INFO")
  category String  @default("messages")
  isRead   Boolean @default(false)

  userId      String
  referenceId String?

  createdAt DateTime @default(now())
}

model Transaction {
  id          String            @id @default(cuid())
  title       String
  description String?
  amount      Decimal           @db.Decimal(15, 2)
  type        TransactionType
  category    String
  status      TransactionStatus @default(COMPLETED)
  date        DateTime
  account     String?
  merchant    String?
  reference   String?
  notes       String?
  receipt     String?

  employeeId     String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String          @id @default(cuid())
  accountCode       String
  name              String
  type              AccountType
  category          AccountCategory
  subcategory       String?
  parentAccountId   String?
  parentAccount     Account?        @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts     Account[]       @relation("AccountHierarchy")
  normalBalance     NormalBalance
  currentBalance    Decimal         @default(0) @db.Decimal(15, 2)
  openingBalance    Decimal         @default(0) @db.Decimal(15, 2)
  closingBalance    Decimal         @default(0) @db.Decimal(15, 2)
  status            AccountStatus   @default(ACTIVE)
  description       String?
  department        String?
  taxRelated        Boolean         @default(false)
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  notes             String?
  createdBy         String?

  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id])

  journalLines      JournalLine[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([organizationId, accountCode])
}

model JournalEntry {
  id              String        @id @default(cuid())
  entryNumber     String
  date            DateTime
  type            JournalType   @default(GENERAL)
  status          JournalStatus @default(DRAFT)
  description     String?
  reference       String?
  totalDebit      Decimal       @default(0) @db.Decimal(15, 2)
  totalCredit     Decimal       @default(0) @db.Decimal(15, 2)
  createdBy       String?
  approvedBy      String?
  postedBy        String?

  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])

  lines           JournalLine[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([organizationId, entryNumber])
}

model JournalLine {
  id              String       @id @default(cuid())
  description     String?
  debit           Decimal      @default(0) @db.Decimal(15, 2)
  credit          Decimal      @default(0) @db.Decimal(15, 2)

  journalEntryId  String
  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId       String
  account         Account      @relation(fields: [accountId], references: [id])

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Vendor {
  id              String        @id @default(cuid())
  name            String
  code            String
  type            VendorType    @default(SUPPLIER)
  status          VendorStatus  @default(ACTIVE)
  email           String?
  phone           String?
  website         String?
  taxId           String?
  paymentTerms    PaymentTerms  @default(NET_30)
  currency        String        @default("USD")
  rating          Int           @default(0)
  notes           String?

  contactName     String?
  contactEmail    String?
  contactPhone    String?
  contactTitle    String?

  addressStreet   String?
  addressCity     String?
  addressState    String?
  addressZip      String?
  addressCountry  String?

  bankName        String?
  bankAccountName String?
  bankAccountNumber String?
  bankRoutingNumber String?
  bankSwift       String?

  categories      String[]

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  bills           VendorBill[]
  purchaseOrders  PurchaseOrder[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([organizationId, code])
}

model VendorBill {
  id              String        @id @default(cuid())
  billNumber      String
  type            BillType      @default(PURCHASE)
  status          BillStatus    @default(DRAFT)
  issueDate       DateTime
  dueDate         DateTime
  description     String?
  subtotal        Decimal       @db.Decimal(15, 2)
  taxRate         Decimal?      @db.Decimal(5, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(15, 2)
  discountRate    Decimal?      @db.Decimal(5, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(15, 2)
  totalAmount     Decimal       @db.Decimal(15, 2)
  amountPaid      Decimal       @default(0) @db.Decimal(15, 2)
  balanceDue      Decimal       @db.Decimal(15, 2)
  notes           String?
  documentUrl     String?
  approvedBy      String?
  approvedAt      DateTime?

  vendorId        String
  vendor          Vendor        @relation(fields: [vendorId], references: [id])

  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])

  lines           BillLineItem[]
  payments        BillPayment[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([organizationId, billNumber])
}

model BillLineItem {
  id          String    @id @default(cuid())
  description String
  quantity    Decimal   @db.Decimal(10, 2)
  unitPrice   Decimal   @db.Decimal(15, 2)
  amount      Decimal   @db.Decimal(15, 2)
  accountCode String?
  accountName String?

  billId      String
  bill        VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PurchaseOrder {
  id                  String        @id @default(cuid())
  poNumber            String
  status              POStatus      @default(DRAFT)
  priority            POPriority    @default(MEDIUM)
  orderDate           DateTime
  expectedDeliveryDate DateTime
  actualDeliveryDate  DateTime?
  deliveryMethod      DeliveryMethod @default(DELIVERY)
  deliveryAddress     String?
  deliveryNotes       String?
  subtotal            Decimal       @db.Decimal(15, 2)
  taxRate             Decimal?      @db.Decimal(5, 2)
  taxAmount           Decimal       @default(0) @db.Decimal(15, 2)
  totalAmount         Decimal       @db.Decimal(15, 2)
  notes               String?
  approvedBy          String?
  approvedAt          DateTime?
  orderedBy           String?
  orderedAt           DateTime?
  receivedBy          String?
  receivedAt          DateTime?

  vendorId            String
  vendor              Vendor        @relation(fields: [vendorId], references: [id])

  organizationId      String
  organization        Organization  @relation(fields: [organizationId], references: [id])

  lines               PurchaseOrderLineItem[]

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([organizationId, poNumber])
}

model PurchaseOrderLineItem {
  id                String    @id @default(cuid())
  description       String
  quantity          Decimal   @db.Decimal(10, 2)
  unitPrice         Decimal   @db.Decimal(15, 2)
  receivedQuantity  Decimal   @default(0) @db.Decimal(10, 2)
  amount            Decimal   @db.Decimal(15, 2)
  accountCode       String?
  accountName       String?

  poId              String
  po                PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model BillPayment {
  id              String            @id @default(cuid())
  paymentNumber   String
  amount          Decimal           @db.Decimal(15, 2)
  paymentDate     DateTime
  paymentMethod   BillPaymentMethod @default(BANK_TRANSFER)
  status          BillPaymentStatus @default(PENDING)
  reference       String?
  notes           String?

  bankName        String?
  bankAccountNumber String?
  chequeNumber    String?
  cardLast4       String?
  onlineReference String?

  approvedBy      String?
  approvedAt      DateTime?
  processedBy     String?
  processedAt     DateTime?
  confirmedBy     String?
  confirmedAt     DateTime?

  billId          String
  bill            VendorBill        @relation(fields: [billId], references: [id])

  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id])

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([organizationId, paymentNumber])
}
