generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  FINANCE_MANAGER
  ACCOUNTANT_PAYABLE
  ACCOUNTANT_RECEIVABLE
  PAYROLL_OFFICER
  BUDGET_ANALYST
  DEPARTMENT_HEAD
  EMPLOYEE
  AUDITOR
  TAX_SPECIALIST
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  INTERNATIONAL_TRANSFER
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
}

enum PayrollStatus {
  DRAFT
  COMPUTED
  APPROVED
  PAID
  CANCELLED
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REIMBURSED
}

enum ReimbursementStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  MOBILE_PAYMENT
  COMPANY_CARD
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum BudgetStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountCategory {
  CURRENT
  FIXED
  INTANGIBLE
  LONG_TERM
  OPERATING
  NON_OPERATING
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum JournalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  REJECTED
}

enum JournalType {
  GENERAL
  ADJUSTING
  CLOSING
  REVERSING
  PAYROLL
  SALES
  PURCHASE
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum VendorType {
  SUPPLIER
  CONTRACTOR
  CONSULTANT
  SERVICE_PROVIDER
  INDIVIDUAL
}

enum PaymentTerms {
  NET_15
  NET_30
  NET_45
  NET_60
  NET_90
  DUE_ON_RECEIPT
  COD
}

enum BillStatus {
  DRAFT
  PENDING
  APPROVED
  PAID
  OVERDUE
  CANCELLED
}

enum BillType {
  PURCHASE
  SERVICE
  UTILITY
  RENT
  OTHER
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED
  REJECTED
}

enum POPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
  COURIER
}

enum BillPaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum BillPaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  CREDIT_CARD
  ONLINE
}

model Organization {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  email      String?
  phone      String?
  address    String?
  logo       String?
  isPlatform Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  departments       Department[]
  employees         Employee[]
  budgets           Budget[]
  payrollRuns       PayrollRun[]
  customerInvoices  CustomerInvoice[]
  vendorInvoices    VendorInvoice[]
  taxConfigurations TaxConfiguration[]
  auditLogs         AuditLog[]
  transactions      Transaction[]
  accounts          Account[]
  journalEntries    JournalEntry[]
  vendors           Vendor[]
  vendorBills       VendorBill[]
  purchaseOrders    PurchaseOrder[]
  billPayments      BillPayment[]

  customers           Customer[]
  salesInvoices       SalesInvoice[]
  customerPayments    CustomerPayment[]
  creditNotes         CreditNote[]

  expenseReports      ExpenseReport[]
  reimbursements      Reimbursement[]
  assets              Asset[]
  assetDisposals      AssetDisposal[]
  pettyCashRequests   PettyCashRequest[]
  pettyCashReimbursements PettyCashReimbursement[]

  settings Json? @default("{}")
}

model Department {
  id             String       @id @default(cuid())
  name           String
  code           String       @unique
  description    String?
  costCenter     String?
  budgetAmount   Decimal?     @default(0) @db.Decimal(15, 2)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  head      String?
  employees Employee[]
  budgets   Budget[]
}

model Employee {
  id           String   @id @default(cuid())
  employeeCode String   @unique
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  position     String?
  baseSalary   Decimal? @default(0) @db.Decimal(15, 2)
  passwordHash String?
  bankName     String?
  bankAccount  String?
  bankCode     String?
  taxId        String?
  hireDate     DateTime?
  isActive     Boolean  @default(true)
  role         Role     @default(EMPLOYEE)

  jobTitle      String?
  bio           String?   @db.VarChar(500)
  avatarUrl     String?
  lastLoginAt   DateTime?
  preferences   Json?

  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollItems      PayrollItem[]
  expenseReports    ExpenseReport[]
  reimbursements    Reimbursement[]
  timesheets        Timesheet[]
  loans             EmployeeLoan[]
  approvals         ApprovalRequest[]
  approvalsApproved ApprovalRequest[] @relation("ApproverRelation")
}

model Timesheet {
  id          String         @id @default(cuid())
  date        DateTime
  hoursWorked Decimal?       @db.Decimal(5, 2)
  overtime    Decimal?       @default(0) @db.Decimal(5, 2)
  status      ApprovalStatus @default(PENDING)
  notes       String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayrollRun {
  id          String        @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  totalAmount Decimal?      @default(0) @db.Decimal(15, 2)
  status      PayrollStatus @default(DRAFT)
  processedAt DateTime?
  notes       String?
  processedBy String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PayrollItem[]
}

model PayrollItem {
  id            String  @id @default(cuid())
  grossPay      Decimal @db.Decimal(15, 2)
  deductions    Decimal @default(0) @db.Decimal(15, 2)
  taxAmount     Decimal @default(0) @db.Decimal(15, 2)
  netPay        Decimal @db.Decimal(15, 2)
  allowances    Decimal @default(0) @db.Decimal(15, 2)
  bonus         Decimal @default(0) @db.Decimal(15, 2)
  loanDeduction Decimal @default(0) @db.Decimal(15, 2)
  overtimePay   Decimal @default(0) @db.Decimal(15, 2)

  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExpenseReport {
  id              String        @id @default(cuid())
  title           String
  description     String?
  department      String?
  totalAmount     Decimal       @default(0) @db.Decimal(15, 2)
  status          ExpenseStatus @default(DRAFT)
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  rejectedReason  String?
  reimbursedAt    DateTime?
  receiptUrl      String?
  notes           String?

  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  employeeName    String?
  employeeEmail   String?

  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           ExpenseItem[]
  reimbursements  Reimbursement[]
}

model ExpenseItem {
  id              String        @id @default(cuid())
  category        String
  description     String
  amount          Decimal       @db.Decimal(15, 2)
  receiptUrl      String?
  expenseDate     DateTime
  paymentMethod   PaymentMethod @default(COMPANY_CARD)
  isReimbursable  Boolean       @default(false)
  merchant        String?

  expenseReportId String
  expenseReport   ExpenseReport @relation(fields: [expenseReportId], references: [id], onDelete: Cascade)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Reimbursement {
  id                  String              @id @default(cuid())
  amount              Decimal             @db.Decimal(15, 2)
  status              ReimbursementStatus @default(PENDING)
  description         String?
  submittedAt         DateTime            @default(now())
  approvedAt          DateTime?
  approvedBy          String?
  paidAt              DateTime?
  rejectionReason     String?
  category            String?
  paymentMethod       PaymentMethod?
  employeeName        String?
  employeeEmail       String?
  department          String?

  expenseReportId     String
  expenseReport       ExpenseReport       @relation(fields: [expenseReportId], references: [id])

  employeeId          String
  employee            Employee            @relation(fields: [employeeId], references: [id])

  organizationId      String
  organization        Organization        @relation(fields: [organizationId], references: [id])

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model CustomerInvoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  customerName    String
  customerEmail   String?
  customerAddress String?
  totalAmount     Decimal       @db.Decimal(15, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(15, 2)
  dueDate         DateTime
  status          InvoiceStatus @default(DRAFT)
  notes           String?
  pdfUrl          String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CustomerInvoiceItem[]
}

model CustomerInvoiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(15, 2)
  total       Decimal @db.Decimal(15, 2)

  invoiceId String
  invoice   CustomerInvoice @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VendorInvoice {
  id            String        @id @default(cuid())
  vendorName    String
  invoiceNumber String
  totalAmount   Decimal       @db.Decimal(15, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(15, 2)
  dueDate       DateTime
  status        InvoiceStatus @default(DRAFT)
  notes         String?
  documentUrl   String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Budget {
  id          String       @id @default(cuid())
  fiscalYear  Int
  totalAmount Decimal      @db.Decimal(15, 2)
  spentAmount Decimal      @default(0) @db.Decimal(15, 2)
  status      BudgetStatus @default(ACTIVE)

  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems BudgetLineItem[]
}

model BudgetLineItem {
  id          String  @id @default(cuid())
  category    String
  description String?
  allocated   Decimal @db.Decimal(15, 2)
  spent       Decimal @default(0) @db.Decimal(15, 2)

  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeLoan {
  id                String         @id @default(cuid())
  amount            Decimal        @db.Decimal(15, 2)
  monthlyDeduction  Decimal        @db.Decimal(15, 2)
  remainingBalance  Decimal        @db.Decimal(15, 2)
  totalInstallments Int
  paidInstallments  Int            @default(0)
  status            ApprovalStatus @default(PENDING)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApprovalRequest {
  id          String         @id @default(cuid())
  title       String
  description String?
  type        String
  status      ApprovalStatus @default(PENDING)
  priority    String         @default("NORMAL")
  dueDate     DateTime?

  requesterId String
  requester   Employee @relation(fields: [requesterId], references: [id])

  approverId String?
  approver   Employee? @relation("ApproverRelation", fields: [approverId], references: [id])

  approvedAt DateTime?
  comments   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps ApprovalStep[]
}

model ApprovalStep {
  id        String         @id @default(cuid())
  stepOrder Int
  role      Role
  status    ApprovalStatus @default(PENDING)
  comment   String?

  requestId String
  request   ApprovalRequest @relation(fields: [requestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaxConfiguration {
  id        String   @id @default(cuid())
  name      String
  rate      Decimal  @db.Decimal(5, 2)
  threshold Decimal? @db.Decimal(15, 2)
  isActive  Boolean  @default(true)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String  @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?

  userId   String?
  userName String?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
}

model Notification {
  id       String  @id @default(cuid())
  title    String
  message  String
  body     String?
  type     String  @default("INFO")
  category String  @default("messages")
  isRead   Boolean @default(false)

  userId      String
  referenceId String?

  createdAt DateTime @default(now())
}

model Transaction {
  id          String            @id @default(cuid())
  title       String
  description String?
  amount      Decimal           @db.Decimal(15, 2)
  type        TransactionType
  category    String
  status      TransactionStatus @default(COMPLETED)
  date        DateTime
  account     String?
  merchant    String?
  reference   String?
  notes       String?
  receipt     String?

  employeeId     String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String          @id @default(cuid())
  accountCode       String
  name              String
  type              AccountType
  category          AccountCategory
  subcategory       String?
  parentAccountId   String?
  parentAccount     Account?        @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts     Account[]       @relation("AccountHierarchy")
  normalBalance     NormalBalance
  currentBalance    Decimal         @default(0) @db.Decimal(15, 2)
  openingBalance    Decimal         @default(0) @db.Decimal(15, 2)
  closingBalance    Decimal         @default(0) @db.Decimal(15, 2)
  status            AccountStatus   @default(ACTIVE)
  description       String?
  department        String?
  taxRelated        Boolean         @default(false)
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  notes             String?
  createdBy         String?

  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id])

  journalLines      JournalLine[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([organizationId, accountCode])
}

model JournalEntry {
  id              String        @id @default(cuid())
  entryNumber     String
  date            DateTime
  type            JournalType   @default(GENERAL)
  status          JournalStatus @default(DRAFT)
  description     String?
  reference       String?
  totalDebit      Decimal       @default(0) @db.Decimal(15, 2)
  totalCredit     Decimal       @default(0) @db.Decimal(15, 2)
  createdBy       String?
  approvedBy      String?
  postedBy        String?

  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])

  lines           JournalLine[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([organizationId, entryNumber])
}

model JournalLine {
  id              String       @id @default(cuid())
  description     String?
  debit           Decimal      @default(0) @db.Decimal(15, 2)
  credit          Decimal      @default(0) @db.Decimal(15, 2)

  journalEntryId  String
  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId       String
  account         Account      @relation(fields: [accountId], references: [id])

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Vendor {
  id              String        @id @default(cuid())
  name            String
  code            String
  type            VendorType    @default(SUPPLIER)
  status          VendorStatus  @default(ACTIVE)
  email           String?
  phone           String?
  website         String?
  taxId           String?
  paymentTerms    PaymentTerms  @default(NET_30)
  currency        String        @default("USD")
  rating          Int           @default(0)
  notes           String?

  contactName     String?
  contactEmail    String?
  contactPhone    String?
  contactTitle    String?

  addressStreet   String?
  addressCity     String?
  addressState    String?
  addressZip      String?
  addressCountry  String?

  bankName        String?
  bankAccountName String?
  bankAccountNumber String?
  bankRoutingNumber String?
  bankSwift       String?

  categories      String[]

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  bills           VendorBill[]
  purchaseOrders  PurchaseOrder[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([organizationId, code])
}

model VendorBill {
  id              String        @id @default(cuid())
  billNumber      String
  type            BillType      @default(PURCHASE)
  status          BillStatus    @default(DRAFT)
  issueDate       DateTime
  dueDate         DateTime
  description     String?
  subtotal        Decimal       @db.Decimal(15, 2)
  taxRate         Decimal?      @db.Decimal(5, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(15, 2)
  discountRate    Decimal?      @db.Decimal(5, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(15, 2)
  totalAmount     Decimal       @db.Decimal(15, 2)
  amountPaid      Decimal       @default(0) @db.Decimal(15, 2)
  balanceDue      Decimal       @db.Decimal(15, 2)
  notes           String?
  documentUrl     String?
  approvedBy      String?
  approvedAt      DateTime?

  vendorId        String
  vendor          Vendor        @relation(fields: [vendorId], references: [id])

  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])

  lines           BillLineItem[]
  payments        BillPayment[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([organizationId, billNumber])
}

model BillLineItem {
  id          String    @id @default(cuid())
  description String
  quantity    Decimal   @db.Decimal(10, 2)
  unitPrice   Decimal   @db.Decimal(15, 2)
  amount      Decimal   @db.Decimal(15, 2)
  accountCode String?
  accountName String?

  billId      String
  bill        VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PurchaseOrder {
  id                  String        @id @default(cuid())
  poNumber            String
  status              POStatus      @default(DRAFT)
  priority            POPriority    @default(MEDIUM)
  orderDate           DateTime
  expectedDeliveryDate DateTime
  actualDeliveryDate  DateTime?
  deliveryMethod      DeliveryMethod @default(DELIVERY)
  deliveryAddress     String?
  deliveryNotes       String?
  subtotal            Decimal       @db.Decimal(15, 2)
  taxRate             Decimal?      @db.Decimal(5, 2)
  taxAmount           Decimal       @default(0) @db.Decimal(15, 2)
  totalAmount         Decimal       @db.Decimal(15, 2)
  notes               String?
  approvedBy          String?
  approvedAt          DateTime?
  orderedBy           String?
  orderedAt           DateTime?
  receivedBy          String?
  receivedAt          DateTime?

  vendorId            String
  vendor              Vendor        @relation(fields: [vendorId], references: [id])

  organizationId      String
  organization        Organization  @relation(fields: [organizationId], references: [id])

  lines               PurchaseOrderLineItem[]

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([organizationId, poNumber])
}

model PurchaseOrderLineItem {
  id                String    @id @default(cuid())
  description       String
  quantity          Decimal   @db.Decimal(10, 2)
  unitPrice         Decimal   @db.Decimal(15, 2)
  receivedQuantity  Decimal   @default(0) @db.Decimal(10, 2)
  amount            Decimal   @db.Decimal(15, 2)
  accountCode       String?
  accountName       String?

  poId              String
  po                PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model BillPayment {
  id              String            @id @default(cuid())
  paymentNumber   String
  amount          Decimal           @db.Decimal(15, 2)
  paymentDate     DateTime
  paymentMethod   BillPaymentMethod @default(BANK_TRANSFER)
  status          BillPaymentStatus @default(PENDING)
  reference       String?
  notes           String?

  bankName        String?
  bankAccountNumber String?
  chequeNumber    String?
  cardLast4       String?
  onlineReference String?

  approvedBy      String?
  approvedAt      DateTime?
  processedBy     String?
  processedAt     DateTime?
  confirmedBy     String?
  confirmedAt     DateTime?

  billId          String
  bill            VendorBill        @relation(fields: [billId], references: [id])

  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id])

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([organizationId, paymentNumber])
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLACKLISTED
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
  GOVERNMENT
  NON_PROFIT
}

enum CreditRating {
  AAA
  AA
  A
  BBB
  BB
  B
  CCC
  D
}

enum SalesInvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceType {
  STANDARD
  PROFORMA
  CREDIT_NOTE
  DEBIT_NOTE
}

enum CustomerPaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum CustomerPaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  CREDIT_CARD
  ONLINE
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  APPLIED
  CANCELLED
}

enum CreditNoteReason {
  PRODUCT_RETURN
  PRICE_ADJUSTMENT
  DAMAGED_GOODS
  SERVICE_ISSUE
  BILLING_ERROR
  GOODWILL
  OTHER
}

model Customer {
  id              String         @id @default(cuid())
  name            String
  code            String
  type            CustomerType   @default(BUSINESS)
  status          CustomerStatus @default(ACTIVE)
  email           String?
  phone           String?
  website         String?
  taxId           String?
  creditLimit     Decimal        @default(0) @db.Decimal(15, 2)
  currentBalance  Decimal        @default(0) @db.Decimal(15, 2)
  creditRating    CreditRating   @default(BBB)
  paymentTerms    String         @default("Net 30")
  currency        String         @default("USD")
  industry        String?
  notes           String?

  contactName     String?
  contactEmail    String?
  contactPhone    String?
  contactTitle    String?

  addressStreet   String?
  addressCity     String?
  addressState    String?
  addressZip      String?
  addressCountry  String?

  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])

  invoices        SalesInvoice[]
  payments        CustomerPayment[]
  creditNotes     CreditNote[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([organizationId, code])
}

model SalesInvoice {
  id              String          @id @default(cuid())
  invoiceNumber   String
  type            InvoiceType     @default(STANDARD)
  status          SalesInvoiceStatus @default(DRAFT)
  invoiceDate     DateTime
  dueDate         DateTime
  description     String?
  subtotal        Decimal            @db.Decimal(15, 2)
  taxRate         Decimal?           @db.Decimal(5, 2)
  taxAmount       Decimal            @default(0) @db.Decimal(15, 2)
  discountRate    Decimal?           @db.Decimal(5, 2)
  discountAmount  Decimal            @default(0) @db.Decimal(15, 2)
  totalAmount     Decimal            @db.Decimal(15, 2)
  amountPaid      Decimal            @default(0) @db.Decimal(15, 2)
  balanceDue      Decimal            @db.Decimal(15, 2)
  notes           String?
  terms           String?
  currency        String          @default("USD")
  approvedBy      String?
  approvedAt      DateTime?
  sentAt          DateTime?

  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id])

  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id])

  lines           SalesInvoiceLineItem[]
  payments        CustomerPayment[]
  creditNotes     CreditNote[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([organizationId, invoiceNumber])
}

model SalesInvoiceLineItem {
  id          String    @id @default(cuid())
  description String
  quantity    Decimal   @db.Decimal(10, 2)
  unitPrice   Decimal   @db.Decimal(15, 2)
  amount      Decimal   @db.Decimal(15, 2)
  discount    Decimal   @default(0) @db.Decimal(5, 2)
  tax         Decimal   @default(0) @db.Decimal(5, 2)
  accountCode String?
  accountName String?

  invoiceId   String
  invoice     SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CustomerPayment {
  id              String                @id @default(cuid())
  paymentNumber   String
  amount          Decimal               @db.Decimal(15, 2)
  paymentDate     DateTime
  paymentMethod   CustomerPaymentMethod @default(BANK_TRANSFER)
  status          CustomerPaymentStatus @default(PENDING)
  reference       String?
  notes           String?
  bankName        String?
  bankAccountNumber String?
  chequeNumber    String?
  cardLast4       String?
  onlineReference String?
  approvedBy      String?
  approvedAt      DateTime?

  invoiceId       String
  invoice         SalesInvoice          @relation(fields: [invoiceId], references: [id])

  customerId      String
  customer        Customer              @relation(fields: [customerId], references: [id])

  organizationId  String
  organization    Organization          @relation(fields: [organizationId], references: [id])

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([organizationId, paymentNumber])
}

model CreditNote {
  id              String            @id @default(cuid())
  creditNoteNumber String
  status          CreditNoteStatus  @default(DRAFT)
  reason          CreditNoteReason  @default(OTHER)
  reasonDescription String?
  issueDate       DateTime
  expiryDate      DateTime?
  subtotal        Decimal           @db.Decimal(15, 2)
  taxRate         Decimal?          @db.Decimal(5, 2)
  taxAmount       Decimal           @default(0) @db.Decimal(15, 2)
  totalAmount     Decimal           @db.Decimal(15, 2)
  remainingAmount Decimal           @db.Decimal(15, 2)
  notes           String?
  approvedBy      String?
  approvedAt      DateTime?

  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id])

  invoiceId       String?
  invoice         SalesInvoice?     @relation(fields: [invoiceId], references: [id])

  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id])

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([organizationId, creditNoteNumber])
}

model Asset {
  id                   String   @id @default(cuid())
  name                 String
  code                 String
  category             String
  description          String?
  serialNumber         String?
  purchasePrice        Decimal  @db.Decimal(15, 2)
  currentValue         Decimal  @db.Decimal(15, 2)
  purchaseDate         DateTime
  depreciationMethod   String?
  usefulLife           Int?
  salvageValue         Decimal? @db.Decimal(15, 2)
  accumulatedDepreciation Decimal @default(0) @db.Decimal(15, 2)
  monthlyDepreciation  Decimal? @default(0) @db.Decimal(15, 2)
  status               String   @default("ACTIVE")
  location             String?
  departmentName       String?
  assignedTo           String?
  supplier             String?
  warrantyExpiry       DateTime?
  notes                String?
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])

  disposals            AssetDisposal[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([organizationId, code])
}

model AssetDisposal {
  id                   String   @id @default(cuid())
  disposalNumber       String
  disposalDate         DateTime
  disposalMethod       String
  saleAmount           Decimal  @default(0) @db.Decimal(15, 2)
  disposalCost         Decimal  @default(0) @db.Decimal(15, 2)
  netProceeds          Decimal  @default(0) @db.Decimal(15, 2)
  bookValueAtDisposal  Decimal  @default(0) @db.Decimal(15, 2)
  gainLoss             Decimal  @default(0) @db.Decimal(15, 2)
  gainLossType         String   @default("gain")
  status               String   @default("PENDING")
  buyerName            String?
  buyerContact         String?
  reason               String?
  approvedBy           String?
  approvedAt           DateTime?
  processedBy          String?
  processedAt          DateTime?
  reference            String?
  notes                String?

  assetId              String
  asset                Asset    @relation(fields: [assetId], references: [id])

  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([organizationId, disposalNumber])
}

model PettyCashRequest {
  id                   String   @id @default(cuid())
  requestNumber        String
  title                String
  description          String?
  amount               Decimal  @db.Decimal(15, 2)
  category             String
  priority             String   @default("MEDIUM")
  status               String   @default("PENDING")
  paymentMethod        String   @default("CASH")
  requestDate          DateTime @default(now())
  expectedDate         DateTime?
  employeeName         String
  employeeEmail        String?
  departmentName       String?
  position             String?
  approvedBy           String?
  approvedAt           DateTime?
  disbursedBy          String?
  disbursedAt          DateTime?
  rejectionReason      String?
  notes                String?
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])

  reimbursements       PettyCashReimbursement[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([organizationId, requestNumber])
}

model PettyCashReimbursement {
  id                   String   @id @default(cuid())
  amount               Decimal  @db.Decimal(15, 2)
  status               String   @default("PENDING")
  description          String?
  category             String?
  submittedAt          DateTime @default(now())
  approvedAt           DateTime?
  approvedBy           String?
  paidAt               DateTime?
  rejectionReason      String?
  employeeName         String?
  employeeEmail        String?
  departmentName       String?

  requestId            String?
  request              PettyCashRequest? @relation(fields: [requestId], references: [id])

  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum MarketingPublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model MarketingBlogPost {
  id          String                 @id @default(cuid())
  slug        String                 @unique
  title       String
  excerpt     String
  content     String                 @db.Text
  category    String
  imageUrl    String?
  publishedAt DateTime               @default(now())
  status      MarketingPublishStatus @default(PUBLISHED)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model MarketingJobListing {
  id           String                 @id @default(cuid())
  slug         String                 @unique
  title        String
  type         String
  location     String
  description  String                 @db.Text
  requirements String                 @db.Text
  status       MarketingPublishStatus @default(PUBLISHED)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  applications MarketingJobApplication[]
}

model MarketingJobApplication {
  id          String              @id @default(cuid())
  jobId       String
  job         MarketingJobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  email       String
  phone       String?
  coverLetter String              @db.Text
  resumeUrl   String?
  status      String              @default("NEW")
  createdAt   DateTime            @default(now())
}

model MarketingChangelogEntry {
  id          String                 @id @default(cuid())
  version     String
  title       String
  items       Json
  publishedAt DateTime               @default(now())
  status      MarketingPublishStatus @default(PUBLISHED)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model MarketingIntegration {
  id          String                 @id @default(cuid())
  slug        String                 @unique
  name        String
  category    String
  description String
  content     String?                @db.Text
  logoUrl     String?
  docsUrl     String?
  status      MarketingPublishStatus @default(PUBLISHED)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model MarketingContactSubmission {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  message   String   @db.Text
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model MarketingNewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
}

enum HelpCenterConversationStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum HelpCenterMessageRole {
  USER
  STAFF
  SYSTEM
  BOT
}

model HelpCenterArticle {
  id        String   @id @default(cuid())
  slug      String   @unique
  question  String
  answer    String   @db.Text
  category  String   @default("general")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HelpCenterConversation {
  id             String                       @id @default(cuid())
  userId         String
  organizationId String
  status         HelpCenterConversationStatus @default(OPEN)
  subject        String                       @default("Help Center")
  userName       String?
  userEmail      String?
  orgName        String?
  lastReadAt     DateTime?
  staffLastReadAt DateTime?
  lastMessageAt  DateTime                     @default(now())
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  messages HelpCenterMessage[]

  @@index([userId, status])
  @@index([organizationId])
  @@index([status, lastMessageAt])
}

model HelpCenterMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   HelpCenterConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           HelpCenterMessageRole
  content        String                @db.Text
  authorId       String?
  authorName     String?
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
}
